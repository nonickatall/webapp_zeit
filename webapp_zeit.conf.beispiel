; ============================================================================
; webapp_zeit.conf -- Konfiguration der Zeiterfassungs-Verwaltung
; ============================================================================
; Liegt neben zeit_web.py (/etc/webapp_zeit/webapp_zeit.conf) und wird NICHT
; deployt (steht in .gitignore) -- je Server von Hand pflegen.
; Vorlage: webapp_zeit.conf.beispiel (diese Datei) -- nach Aenderungen der
; Vorlage die eigene conf von Hand nachziehen.
;
; Grundsatz wie bei den myhome-Diensten:
;   * Adressen, Benutzernamen, Einstellungen  -> hier in der conf
;   * Passwoerter                             -> NUR in /etc/webapp_zeit/.env
;       ZEITWEB_SQL_PASSWD=...     (MySQL-User aus [datenbank] sql_user)
;       ZEITWEB_MQTT_PASSWD=...    (MQTT-User aus [mqtt] mqtt_user)
;     .env: Besitzer myhome, Rechte 600.
;
; Werte, die sich zwischen Entwicklung und Kunde unterscheiden, sind mit
; "Kunde:" gekennzeichnet. Nach Aenderungen: systemctl restart webapp_zeit
; ============================================================================


[webapp_zeit]
; --- Allgemein ---------------------------------------------------------------
; Adresse, unter der die Webapp im Browser erreichbar ist. Wird fuer die
; Einmal-Links aus zeit_benutzer.py verwendet (Passwort setzen).
;   Kunde: https://10.10.10.10:5010
basis_url = https://192.168.0.3:5010

; Logdatei (relativ zu /etc/webapp_zeit) und Kennung in myhome.logdaten (Spalte herkunft)
log_datei = webapp_zeit.log
herkunft = webapp_zeit


[datenbank]
; --- MySQL -------------------------------------------------------------------
; Host EXAKT so, wie der MySQL-User angelegt ist ('webapp_zeit'@'<host>').
; Nie localhost: das geht ueber den Socket und trifft ein anderes Konto.
;   Kunde: 10.10.10.10
sql_address = 192.168.0.3

; MySQL-User der Webapp: nur LESEN in myhome_zeit, dazu Klarnamen/Rechte in
; myhome und INSERT in myhome.logdaten (siehe webapp_zeit_einrichtung.sql).
; Passwort: ZEITWEB_SQL_PASSWD in der .env
sql_user = webapp_zeit

; Datenbanken: Zeiterfassung und myhome-Stammdaten (user, rechte, befehle, logdaten)
sql_db_zeit = myhome_zeit
sql_db_myhome = myhome


[anmeldung]
; --- Zugaenge und Sitzungen --------------------------------------------------
; SQLite-Datei mit Zugaengen und Sitzungen (gilt fuer alle gunicorn-Worker).
; Das Verzeichnis muss dem User myhome gehoeren.
auth_db = /var/lib/myhome/webapp_zeit/auth.db

; Abmeldung nach so vielen Minuten ohne Seitenaufruf
; (beim Entwickeln gern hoeher, z.B. 480; im Betrieb 15)
leerlauf_minuten = 15

; Nach so vielen Fehlversuchen wird ein Zugang fuer sperre_minuten gesperrt
max_fehlversuche = 5
sperre_minuten = 15


[mqtt]
; --- Auftraege an die Engine (Zeitregel anlegen, spaeter Korrekturen) --------
; Die Webapp schreibt nie selbst in myhome_zeit. Aenderungen gehen als Befehl
; ueber den Eingang (Rechtepruefung) an den zeiterfassung_server.
; Fehlen mqtt_host oder mqtt_user, sind nur die Lesefunktionen aktiv.
;   Kunde: 10.10.10.10
mqtt_host = 192.168.0.3
mqtt_port = 1883

; Eigener MQTT-User fuer die Webapp (in /etc/mosquitto/passwd angelegt).
; Passwort: ZEITWEB_MQTT_PASSWD in der .env
mqtt_user = webapp_zeit

; Eingangs-Topic der Engine (interner_mqtt_eingang)
eingang_topic = /myhome/interner_mqtt_eingang
